-- pen_watch_v3.lua (TEMPLATE - fill in the settings below before running)
-- Requires: Player Detector, Environment Detector, Geo Scanner, Chat Box (all Advanced Peripherals)
-- Place all peripherals near/attached to the same Computer (wired modem + cables work too)
--
-- BEFORE RUNNING, CHANGE THIS:
--   Line ~13: YOUR_NAME = "YourUsernameHere"  -> replace with your exact in-game username
--             (case-sensitive - must match how it appears in chat/tab list)
--
-- OPTIONAL TWEAKS (only change if you want different behavior):
--   Line ~10: RADIUS        - how far out (in blocks) to watch for players/animals
--   Line ~11: SCAN_RADIUS   - how far out to scan for sculk blocks (server may cap this)
--   Line ~14: LOG_FILE      - filename the log gets saved to on the computer's disk
--   Line ~16: SCAN_INTERVAL - seconds between sculk scans (raise this if you see scan errors)

local playerDet = peripheral.find("playerDetector")
local envDet = peripheral.find("environmentDetector") -- handles entity scanning (was called "entity detector" in old versions)
local geoScanner = peripheral.find("geoScanner")
local chatBox = peripheral.find("chatBox")

local RADIUS = 50          -- player/animal detection radius (Player Detector handles 500+ fine)
local SCAN_RADIUS = 16     -- geo scanner radius, capped here
local MIN_SCAN_RADIUS = 8  -- if 16 is rejected, we'll step down toward this until a scan succeeds
local YOUR_NAME = "YourUsernameHere"  -- <<< CHANGE THIS to your in-game name
local LOG_FILE = "penwatch.log"
local CHECK_INTERVAL = 2
local SCAN_INTERVAL = 12   -- geo scanner has a cooldown, don't spam it

if not playerDet then error("No Player Detector found. Attach one via Advanced Peripherals.") end
if not envDet then error("No Environment Detector found. Attach one via Advanced Peripherals.") end
if not geoScanner then error("No Geo Scanner found. Attach one via Advanced Peripherals.") end

local SCULK_NAMES = {
  ["minecraft:sculk"] = true,
  ["minecraft:sculk_catalyst"] = true,
  ["minecraft:sculk_sensor"] = true,
  ["minecraft:sculk_shrieker"] = true,
  ["minecraft:sculk_vein"] = true,
}

local ANIMAL_TYPES = {
  ["minecraft:cow"] = true,
  ["minecraft:sheep"] = true,
  ["minecraft:pig"] = true,
  ["minecraft:chicken"] = true,
  ["minecraft:horse"] = true,
}

local function timestamp() return os.date("%Y-%m-%d %H:%M:%S") end

local function logLine(line)
  print(line)
  local f = fs.open(LOG_FILE, "a")
  f.write(line .. "\n")
  f.close()
end

local function countAnimals()
  local ok, entities = pcall(function() return envDet.scanEntities(RADIUS) end)
  if not ok then return nil end
  local count = 0
  for _, e in ipairs(entities) do
    if ANIMAL_TYPES[e.name] then count = count + 1 end
  end
  return count
end

local lastWorkingRadius = nil

local function countSculk()
  -- try SCAN_RADIUS first; if the server config caps it lower, step down until a scan succeeds
  local blocks = nil
  local usedRadius = SCAN_RADIUS
  while usedRadius >= MIN_SCAN_RADIUS do
    local ok, result = pcall(function() return geoScanner.scan(usedRadius) end)
    if ok and result then
      blocks = result
      break
    end
    usedRadius = usedRadius - 8
  end

  if not blocks then
    logLine(timestamp() .. " | Geo Scanner failed even at radius " .. MIN_SCAN_RADIUS .. " - check FE/fuel or server-config max range.")
    return nil
  end

  if usedRadius < SCAN_RADIUS then
    -- only warn once per drop, not every single scan
    if usedRadius ~= (lastWorkingRadius or SCAN_RADIUS) then
      logLine(timestamp() .. " | Note: server capped scan radius to " .. usedRadius .. " (requested " .. SCAN_RADIUS .. ")")
    end
  end
  lastWorkingRadius = usedRadius

  local count = 0
  local hasCatalyst = false
  for _, b in ipairs(blocks) do
    if SCULK_NAMES[b.name] then
      count = count + 1
      if b.name == "minecraft:sculk_catalyst" then hasCatalyst = true end
    end
  end
  return count, hasCatalyst
end

local present = {}
local lastAnimalCount = countAnimals() or 0
local lastSculkCount, hasCatalyst = countSculk()
lastSculkCount = lastSculkCount or 0

logLine(timestamp() .. " | Started. Animals: " .. lastAnimalCount .. " | Sculk blocks: " .. lastSculkCount .. (hasCatalyst and " (catalyst present!)" or ""))

local lastScanTime = os.clock()

while true do
  -- player presence
  local players = playerDet.getPlayersInRange(RADIUS)
  local nowPresent = {}
  for _, name in ipairs(players) do
    if name ~= YOUR_NAME then
      nowPresent[name] = true
      if not present[name] then
        present[name] = timestamp()
        logLine(timestamp() .. " | ENTER: " .. name)
      end
    end
  end
  for name, enterTime in pairs(present) do
    if not nowPresent[name] then
      logLine(timestamp() .. " | EXIT:  " .. name .. " (since " .. enterTime .. ")")
      present[name] = nil
    end
  end

  -- animal count
  local currentAnimals = countAnimals()
  if currentAnimals and currentAnimals < lastAnimalCount then
    local drop = lastAnimalCount - currentAnimals
    local suspects = {}
    for name, _ in pairs(present) do table.insert(suspects, name) end
    local suspectStr = (#suspects > 0) and table.concat(suspects, ", ") or "no player nearby"
    local msg = timestamp() .. " | ALERT: Lost " .. drop .. " animal(s). Nearby: " .. suspectStr
    logLine(msg)
    if chatBox then chatBox.sendMessage(msg, "Pen Watch", "&4") end
  end
  if currentAnimals then lastAnimalCount = currentAnimals end

  -- sculk scan (throttled to avoid cooldown errors)
  if os.clock() - lastScanTime >= SCAN_INTERVAL then
    lastScanTime = os.clock()
    local newSculkCount, newHasCatalyst = countSculk()
    if newSculkCount then
      if newSculkCount > lastSculkCount then
        local grew = newSculkCount - lastSculkCount
        local suspects = {}
        for name, _ in pairs(present) do table.insert(suspects, name) end
        local suspectStr = (#suspects > 0) and table.concat(suspects, ", ") or "no player nearby (likely natural catalyst spread from a nearby death)"
        local msg = timestamp() .. " | SCULK BLOOM: +" .. grew .. " sculk block(s). Nearby: " .. suspectStr
        logLine(msg)
        if chatBox then chatBox.sendMessage(msg, "Sculk Alert", "&5") end
      end
      lastSculkCount = newSculkCount
    end
  end

  sleep(CHECK_INTERVAL)
end
