-- ============================================================
-- FIRST-RUN SETUP
-- ============================================================
-- GraveSight asks for the owner and an admin password the first
-- time it starts. The password is stored as a hash, not plain text.
-- ============================================================

local CONFIG_FILE = "gravesight_config.cfg"
local DEFAULT_OWNER = YOUR_NAME

local setup = {
  configured = false,
  owner = DEFAULT_OWNER,
  passwordHash = ""
}

local function hashPassword(password)
  -- Simple repeatable hash for local protection.
  -- This is not meant to protect a Minecraft server from a
  -- determined attacker who can edit the computer's files.
  local hash = 2166136261
  for i = 1, #password do
    hash = (hash * 16777619 + string.byte(password, i)) % 2147483647
  end
  return tostring(hash)
end

local function loadSetup()
  if not fs.exists(CONFIG_FILE) then return false end

  local file = fs.open(CONFIG_FILE, "r")
  if not file then return false end

  local owner = file.readLine()
  local passwordHash = file.readLine()
  local configured = file.readLine()
  file.close()

  if owner and owner ~= "" and passwordHash and passwordHash ~= "" then
    setup.owner = owner
    setup.passwordHash = passwordHash
    setup.configured = configured == "true"
    return setup.configured
  end

  return false
end

local function saveSetup()
  local file = fs.open(CONFIG_FILE, "w")
  if not file then return false end

  file.writeLine(setup.owner)
  file.writeLine(setup.passwordHash)
  file.writeLine(tostring(setup.configured))
  file.close()
  return true
end

local function passwordCorrect(password)
  return hashPassword(password or "") == setup.passwordHash
end

local function runFirstSetup()
  term.setBackgroundColor(colors.black)
  term.clear()

  local w, h = term.getSize()

  local function center(y, message, color)
    term.setCursorPos(math.max(1, math.floor((w - #message) / 2)), y)
    term.setTextColor(color or colors.white)
    term.write(message)
  end

  center(3, "Diyu's GraveSight", colors.cyan)
  center(5, "WARDEN SCAN // INITIALIZATION", colors.green)
  center(7, "[ SCANNING SYSTEM... ]", colors.lightBlue)
  sleep(0.5)
  center(8, "[ SCANNING PERIPHERALS... ]", colors.lightBlue)
  sleep(0.5)
  center(9, "[ SCANNING CONTROL CORE... ]", colors.lightBlue)
  sleep(0.5)

  term.setTextColor(colors.cyan)
  term.setCursorPos(3, 11)
  term.write("OWNER USERNAME")
  term.setCursorPos(3, 12)
  term.setTextColor(colors.white)
  term.write("> ")
  local owner = read()

  while owner == "" do
    term.setCursorPos(3, 13)
    term.setTextColor(colors.orange)
    term.write("Username cannot be empty.")
    term.setCursorPos(3, 12)
    term.write("> ")
    owner = read()
  end

  term.setCursorPos(3, 15)
  term.setTextColor(colors.cyan)
  term.write("CREATE ADMIN PASSWORD")
  term.setCursorPos(3, 16)
  term.setTextColor(colors.white)
  term.write("> ")
  local password = read("*")

  while password == "" do
    term.setCursorPos(3, 17)
    term.setTextColor(colors.orange)
    term.write("Password cannot be empty.")
    term.setCursorPos(3, 16)
    term.write("> ")
    password = read("*")
  end

  term.setCursorPos(3, 19)
  term.setTextColor(colors.cyan)
  term.write("CONFIRM PASSWORD")
  term.setCursorPos(3, 20)
  term.setTextColor(colors.white)
  term.write("> ")
  local confirm = read("*")

  while confirm ~= password do
    term.setCursorPos(3, 21)
    term.setTextColor(colors.red)
    term.write("Passwords do not match.")
    term.setCursorPos(3, 20)
    term.write("> ")
    confirm = read("*")
  end

  setup.owner = owner
  setup.passwordHash = hashPassword(password)
  setup.configured = true
  saveSetup()

  term.setBackgroundColor(colors.black)
  term.clear()
  center(8, "[ WARDEN CORE ONLINE ]", colors.green)
  center(10, "Owner: " .. setup.owner, colors.white)
  center(12, "GraveSight initialization complete.", colors.cyan)
  sleep(2)
end

