local function loadWhitelist()
  whitelist = {}
  if not fs.exists(WHITELIST_FILE) then return end
  local file = fs.open(WHITELIST_FILE, "r")
  if not file then return end
  while true do
    local name = file.readLine()
    if not name then break end
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    if name ~= "" then whitelist[name:lower()] = name end
  end
  file.close()
end

local function saveWhitelist()
  local file = fs.open(WHITELIST_FILE, "w")
  if not file then return false end
  local names = {}
  for _, name in pairs(whitelist) do table.insert(names, name) end
  table.sort(names, function(a, b) return a:lower() < b:lower() end)
  for _, name in ipairs(names) do file.writeLine(name) end
  file.close()
  return true
end

local function isWhitelisted(name) return whitelist[name:lower()] ~= nil end

local function addToWhitelist(name)
  name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
  if name == "" then return false end
  whitelist[name:lower()] = name
  saveWhitelist()
  return true
end

local function removeFromWhitelist(name)
  if not name then return false end
  local key = name:lower()
  if not whitelist[key] then return false end
  whitelist[key] = nil
  saveWhitelist()
  return true
end

