-- ============================================================
-- 5. LOGGING & UTILITY FUNCTIONS
-- ============================================================

local function timestamp() return os.date("%H:%M:%S") end

local function addLog(line)
  local full = os.date("%Y-%m-%d %H:%M:%S") .. " | " .. line
  table.insert(state.log, full)
  if #state.log > MAX_LOG_ENTRIES then table.remove(state.log, 1) end
  local f = fs.open(LOG_FILE, "a")
  f.write(full .. "\n")
  f.close()
  -- auto-scroll to bottom when new entries arrive
  state.scrollOffset = 0
end

