local function saveSettings()
  local data = {
    radius = RADIUS,
    scanRadius = SCAN_RADIUS,
    checkInterval = CHECK_INTERVAL,
    scanInterval = SCAN_INTERVAL,
    updateInterval = UPDATE_INTERVAL,
    chatAlerts = chatBox ~= nil and true or false,
    animals = {},
    sculk = {},
  }

  for name, enabled in pairs(ANIMAL_TYPES) do
    data.animals[name] = enabled
  end
  for name, enabled in pairs(SCULK_NAMES) do
    data.sculk[name] = enabled
  end

  local file = fs.open(SETTINGS_FILE, "w")
  if file then
    file.write(textutils.serialize(data))
    file.close()
  end
end

local function loadSettings()
  if not fs.exists(SETTINGS_FILE) then return end

  local file = fs.open(SETTINGS_FILE, "r")
  if not file then return end
  local raw = file.readAll()
  file.close()

  local ok, data = pcall(textutils.unserialize, raw)
  if not ok or type(data) ~= "table" then return end

  if type(data.radius) == "number" then RADIUS = math.max(4, math.min(128, data.radius)) end
  if type(data.scanRadius) == "number" then SCAN_RADIUS = math.max(MIN_SCAN_RADIUS, math.min(32, data.scanRadius)) end
  if type(data.checkInterval) == "number" then CHECK_INTERVAL = math.max(1, math.min(30, data.checkInterval)) end
  if type(data.scanInterval) == "number" then SCAN_INTERVAL = math.max(2, math.min(60, data.scanInterval)) end
  if type(data.updateInterval) == "number" then UPDATE_INTERVAL = math.max(60, math.min(3600, data.updateInterval)) end

  if type(data.animals) == "table" then
    for name in pairs(ANIMAL_TYPES) do
      if data.animals[name] ~= nil then ANIMAL_TYPES[name] = data.animals[name] == true end
    end
  end
  if type(data.sculk) == "table" then
    for name in pairs(SCULK_NAMES) do
      if data.sculk[name] ~= nil then SCULK_NAMES[name] = data.sculk[name] == true end
    end
  end
end

