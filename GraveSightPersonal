-- ============================================================
-- SECTION 5: PERIPHERAL & HARDWARE SCANNING
-- Automatically detects required blocks (Player Detector, etc.)
-- ============================================================
local playerDet, envDet, geoScanner, chatBox, modem

local function findPeripheral(possibleNames)
  for _, name in ipairs(peripheral.getNames()) do
    local ptype = peripheral.getType(name)
    for _, candidate in ipairs(possibleNames) do
      if ptype == candidate then return peripheral.wrap(name) end
    end
  end
  return nil
end

local function scanHardware()
  playerDet = findPeripheral({"playerDetector", "player_detector"})
  envDet = findPeripheral({"environmentDetector", "environment_detector"})
  geoScanner = findPeripheral({"geoScanner", "geo_scanner"})
  chatBox = findPeripheral({"chatBox", "chat_box"})
  modem = findPeripheral({"modem"})

  local missing = {}
  if not playerDet then table.insert(missing, "Player Detector") end
  if not envDet then table.insert(missing, "Environment Detector") end
  if not geoScanner then table.insert(missing, "Geo Scanner") end
  return missing
end

local function ensureHardwareAttached()
  local missing = scanHardware()
  while #missing > 0 do
    term.setBackgroundColor(colors.black)
    term.clear()
    local w, h = term.getSize()
    local function center(y, msg, col)
      term.setCursorPos(math.max(1, math.floor((w - #msg) / 2) + 1), y)
      term.setTextColor(col or colors.white)
      term.write(msg)
    end
    center(2, "HARDWARE CONFIGURATION REQUIRED", colors.red)
    center(4, "Missing required peripheral(s):", colors.white)
    for i, item in ipairs(missing) do center(5 + i, "[ ! ] " .. item, colors.yellow) end
    center(h - 2, "Press ANY KEY to retry scan...", colors.cyan)
    os.pullEventRaw("key")
    missing = scanHardware()
  end

  if modem and MODEM_ENABLED_PREF then
    for _, name in ipairs(peripheral.getNames()) do
      if peripheral.getType(name) == "modem" then pcall(function() rednet.open(name) end) end
    end
  end
end

