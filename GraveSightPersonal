local function broadcastOffsite(alertMsg)
  if rednet.isOpen() then
    pcall(function()
      rednet.broadcast({
        system = "GraveSight",
        stationName = setup.stationName,
        owner = setup.owner,
        timestamp = os.date("%Y-%m-%d %H:%M:%S"),
        message = alertMsg
      }, REDNET_CHANNEL)
    end)
  end
end

local function addLog(line)
  local full = os.date("%Y-%m-%d %H:%M:%S") .. " | " .. line
  table.insert(state.log, full)
  if #state.log > MAX_LOG_ENTRIES then table.remove(state.log, 1) end
  local f = fs.open(LOG_FILE, "a")
  if f then
    f.write(full .. "\n")
    f.close()
  end
  state.scrollOffset = 0
  
  if line:find("ALERT") or line:find("ENTER") or line:find("BLOOM") then
    broadcastOffsite(line)
    sendDiscordAlert(line)
  end
end

