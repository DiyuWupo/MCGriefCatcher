-- Load settings, whitelist, etc.
local function loadSettings()
  if not fs.exists(SETTINGS_FILE) then return end
  local file = fs.open(SETTINGS_FILE, "r")
  if not file then return end
  local ok, data = pcall(textutils.unserialize, file.readAll())
  file.close()
  if ok and type(data) == "table" then
    if type(data.radius) == "number" then RADIUS = data.radius end
    if type(data.scanRadius) == "number" then SCAN_RADIUS = data.scanRadius end
    if type(data.theme) == "string" and UI_THEMES[data.theme] then UI_THEME = data.theme end
    if type(data.stationName) == "string" then setup.stationName = data.stationName end
    if type(data.modemEnabled) == "boolean" then MODEM_ENABLED_PREF = data.modemEnabled end
  end
end
loadSettings()

local function loadWhitelist()
  whitelist = {}
  if not fs.exists(WHITELIST_FILE) then return end
  local file = fs.open(WHITELIST_FILE, "r")
  if not file then return end
  while true do
    local name = file.readLine()
    if not name then break end
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    if name ~= "" then whitelist[name:lower()] = name end
  end
  file.close()
end
loadWhitelist()

local function isWhitelisted(name) return whitelist[name:lower()] ~= nil end
local function addToWhitelist(name) whitelist[name:lower()] = name; local f = fs.open(WHITELIST_FILE, "w"); for _, n in pairs(whitelist) do f.writeLine(n) end; f.close(); return true end

-- ============================================================
-- SECTION 7: BACKGROUND MONITORING LOOP
-- Scans for players, animals, sculk, and handles pocket remotes
-- ============================================================
local function countAnimals()
  local ok, entities = pcall(function() return envDet.scanEntities(RADIUS) end)
  if not ok or type(entities) ~= "table" then return nil end
  local count = 0
  for _, e in ipairs(entities) do if ANIMAL_TYPES[e.name] then count = count + 1 end end
  return count
end

local function countSculk()
  local blocks, usedRadius = nil, SCAN_RADIUS
  while usedRadius >= MIN_SCAN_RADIUS do
    local ok, result = pcall(function() return geoScanner.scan(usedRadius) end)
    if ok and type(result) == "table" then blocks = result break end
    usedRadius = usedRadius - 8
  end
  if not blocks then return nil end
  local count, hasCatalyst = 0, false
  for _, b in ipairs(blocks) do
    if SCULK_NAMES[b.name] then count = count + 1; if b.name == "minecraft:sculk_catalyst" then hasCatalyst = true end end
  end
  return count, hasCatalyst
end

local function backgroundLoop()
  state.animals = countAnimals() or 0
  local sc, cat = countSculk()
  state.sculk, state.hasCatalyst = sc or 0, cat or false
  addLog("Started. Station: " .. setup.stationName)

  local lastScanTime = os.clock()

  while state.running do
    -- Listen for pocket remote discovery pings and scan commands
    if rednet.isOpen() then
      local ok, senderID, msg = pcall(function() return rednet.receive(REDNET_CHANNEL, 0) end)
      if ok and senderID and type(msg) == "table" then
        if msg.system == "GraveSightQuery" and msg.command == "discover" then
          pcall(function() rednet.send(senderID, { system = "GraveSightAnnounce", stationName = setup.stationName, computerID = os.getComputerID(), owner = setup.owner }, REDNET_CHANNEL) end)
        elseif msg.system == "GraveSightCmd" and (not msg.target or msg.target == os.getComputerID()) and msg.command == "scan" then
          state.forceUpdate = true
          addLog("REMOTE: Manual scan requested by #" .. tostring(senderID))
        end
      end
    end

    -- Check player presence
    local players = playerDet.getPlayersInRange(RADIUS)
    local nowPresent = {}
    for _, name in ipairs(players) do
      if name ~= YOUR_NAME then
        nowPresent[name] = true
        if not state.present[name] then state.present[name] = timestamp(); addLog("ENTER: " .. name) end
      end
    end
    for name, enterTime in pairs(state.present) do
      if not nowPresent[name] then
        if not isWhitelisted(name) then addLog("EXIT:  " .. name) end
        state.present[name] = nil
      end
    end

    -- Monitor animal counts & sculk growth
    if os.clock() - lastScanTime >= SCAN_INTERVAL or state.forceUpdate then
      lastScanTime = os.clock()
      local newSculk, newCat = countSculk()
      if newSculk and newSculk > state.sculk then
        addLog("SCULK BLOOM: +" .. (newSculk - state.sculk))
      end
      if newSculk then state.sculk = newSculk; state.hasCatalyst = newCat or false end
      state.forceUpdate = false
    end

    os.queueEvent("gravesight_redraw")
    sleep(CHECK_INTERVAL)
  end
end

