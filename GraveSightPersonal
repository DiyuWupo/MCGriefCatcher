      for _, name in ipairs(peripheral.getNames()) do
        if peripheral.getType(name) == "modem" then
          if rednet.isOpen() then rednet.close(name); MODEM_ENABLED_PREF = false else rednet.open(name); MODEM_ENABLED_PREF = true end
        end
      end
    end, rednet.isOpen() and colors.green or colors.red, colors.white)

    -- Radii Controls
    term.setCursorPos(2, contentTop + 6); term.setTextColor(theme().text)
    term.write("Player Radius: " .. string.format("%-3d", RADIUS))
    addButton(21, contentTop + 6, " - ", function() RADIUS = math.max(4, RADIUS - 2) end)
    addButton(25, contentTop + 6, " + ", function() RADIUS = math.min(128, RADIUS + 2) end)
  end

  -- Bottom Exit Button
  clearLine(h - 1, theme().panel)
  clearLine(h)
  addButton(2, h, " Exit to Shell ", function() state.running = false end, colors.red, colors.white)
end

local function uiLoop()
  draw()
  while state.running do
    local event, a, b, c = os.pullEventRaw()
    if event == "mouse_click" then
      for _, btn in ipairs(buttons) do
        if c == btn.y and b >= btn.x1 and b <= btn.x2 then btn.action() end
      end
      if state.running then draw() end
    elseif event == "gravesight_redraw" then
      if state.running then draw() end
    end
  end
end

-- ============================================================
-- SECTION 9: PROGRAM EXECUTION
-- ============================================================
setThemeColors()
os.pullEvent = os.pullEventRaw
pcall(function() parallel.waitForAny(backgroundLoop, uiLoop) end)

term.setBackgroundColor(colors.black)
term.setTextColor(colors.white)
term.clear()
term.setCursorPos(1, 1)
print("GRAVESIGHT stopped.")
