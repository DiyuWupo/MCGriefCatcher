local function countAnimals()
  local ok, entities = pcall(function() return envDet.scanEntities(RADIUS) end)
  if not ok or type(entities) ~= "table" then return nil end
  local count = 0
  for _, e in ipairs(entities) do
    if ANIMAL_TYPES[e.name] then count = count + 1 end
  end
  return count
end

local function countSculk()
  local blocks, usedRadius = nil, SCAN_RADIUS
  while usedRadius >= MIN_SCAN_RADIUS do
    local ok, result = pcall(function() return geoScanner.scan(usedRadius) end)
    if ok and type(result) == "table" then blocks = result break end
    usedRadius = usedRadius - 8
  end
  if not blocks then return nil end

  local count, hasCatalyst = 0, false
  for _, b in ipairs(blocks) do
    if SCULK_NAMES[b.name] then
      count = count + 1
      if b.name == "minecraft:sculk_catalyst" then hasCatalyst = true end
    end
  end
  return count, hasCatalyst
end

