  addLog("Started. Station: " .. setup.stationName .. " | Animals: " .. state.animals .. " | Sculk: " .. state.sculk)

  local lastScanTime = os.clock()
  local lastUpdateCheck = os.clock()

  while state.running do
    if rednet.isOpen() then
      local ok, senderID, msg, protocol = pcall(function()
        return rednet.receive(REDNET_CHANNEL, 0)
      end)
      if ok and senderID and type(msg) == "table" then
        if msg.system == "GraveSightQuery" and msg.command == "discover" then
          pcall(function()
            rednet.send(senderID, {
              system = "GraveSightAnnounce",
              stationName = setup.stationName,
              computerID = os.getComputerID(),
              owner = setup.owner
            }, REDNET_CHANNEL)
          end)
        elseif msg.system == "GraveSightCmd" and (not msg.target or msg.target == os.getComputerID()) and msg.command == "scan" then
          state.forceUpdate = true
          addLog("REMOTE: Manual scan requested by ID " .. tostring(senderID))
        end
      end
    end

    local players = playerDet.getPlayersInRange(RADIUS)
    local nowPresent = {}
    for _, name in ipairs(players) do
      if name ~= YOUR_NAME then
        nowPresent[name] = true
        if not state.present[name] then
          state.present[name] = timestamp()
          addLog("ENTER: " .. name)
        end
      end
    end
    for name, enterTime in pairs(state.present) do
      if not nowPresent[name] then
        if isWhitelisted(name) then
          addLog("INFO: Whitelisted player left: " .. name .. " (since " .. enterTime .. ")")
        else
          addLog("EXIT:  " .. name .. " (since " .. enterTime .. ")")
        end
        state.present[name] = nil
      end
    end

    local currentAnimals = countAnimals()
    if currentAnimals and currentAnimals < state.animals then
      local drop = state.animals - currentAnimals
      local suspects = {}
      for name, _ in pairs(state.present) do
        if not isWhitelisted(name) then table.insert(suspects, name) end
      end
      local suspectStr = (#suspects > 0) and table.concat(suspects, ", ") or "no untrusted player nearby"
      addLog("ALERT: Lost " .. drop .. " animal(s). Nearby: " .. suspectStr)
      if chatBox then chatBox.sendMessage("Lost " .. drop .. " animal(s)! Nearby: " .. suspectStr, "GRAVESIGHT", "&4") end
    end
    if currentAnimals then state.animals = currentAnimals end

    if os.clock() - lastScanTime >= SCAN_INTERVAL or state.forceUpdate then
      lastScanTime = os.clock()
      local newSculk, newCat = countSculk()
      if newSculk then
        if newSculk > state.sculk then
          local grew = newSculk - state.sculk
          local suspects = {}
          for name, _ in pairs(state.present) do
            if not isWhitelisted(name) then table.insert(suspects, name) end
          end
          local suspectStr = (#suspects > 0) and table.concat(suspects, ", ") or "no untrusted player nearby (likely catalyst spread)"
          addLog("SCULK BLOOM: +" .. grew .. ". Nearby: " .. suspectStr)
          if chatBox then chatBox.sendMessage("Sculk bloom +" .. grew .. "! Nearby: " .. suspectStr, "Sculk Alert", "&5") end
        end
        state.sculk = newSculk
        state.hasCatalyst = newCat or false
      end
    end

    if state.forceUpdate then
      addLog("Manual scan triggered.")
      state.forceUpdate = false
    end

    if os.clock() - lastUpdateCheck >= UPDATE_INTERVAL then
      lastUpdateCheck = os.clock()
      checkForUpdate(false)
      if state.restartForUpdate then return end
    end

    os.queueEvent("gravesight_redraw")
    sleep(CHECK_INTERVAL)
  end
end

-- ============================================================
-- 9. USER INTERFACE & THEME CONTROLS
-- ------------------------------------------------------------
local w, h = term.getSize()
local buttons = {}

local function addButton(x, y, text, action, bg, fg)
  term.setCursorPos(x, y)
  term.setBackgroundColor(bg or theme().panel)
  term.setTextColor(fg or colors.white)
  term.write(text)
  table.insert(buttons, {x1 = x, x2 = x + #text - 1, y = y, action = action})
end

local function clearLine(y, bg)
  term.setCursorPos(1, y)
  term.setBackgroundColor(bg or colors.black)
  term.write(string.rep(" ", w))
end

local function draw()
  buttons = {}
  term.setBackgroundColor(theme().background)
  term.clear()

  clearLine(1, theme().accent)
  term.setCursorPos(2, 1)
  term.setTextColor(theme().text)
  term.write("Diyu's GraveSight v" .. VERSION)

  clearLine(2)
  addButton(2, 2, " Status ", function() state.activeTab = "status"; state.settingsMessage = "" end,
    state.activeTab == "status" and theme().accent or theme().panel,
    state.activeTab == "status" and theme().background or theme().text)
  addButton(11, 2, " Log ", function() state.activeTab = "log"; state.settingsMessage = "" end,
    state.activeTab == "log" and theme().accent or theme().panel,
    state.activeTab == "log" and theme().background or theme().text)
  addButton(18, 2, " Settings ", function() state.activeTab = "settings" end,
    state.activeTab == "settings" and theme().accent or theme().panel,
    state.activeTab == "settings" and theme().background or theme().text)

  local contentTop, contentBottom = 4, h - 2

  if state.activeTab == "status" then
    term.setBackgroundColor(theme().background)
    term.setTextColor(theme().text)
    term.setCursorPos(2, contentTop)
    term.write("Network: " .. setup.stationName)
    term.setCursorPos(2, contentTop + 1)
    term.write("Animals: " .. state.animals .. " | Sculk: " .. state.sculk .. (state.hasCatalyst and " (CATALYST!)" or ""))

    term.setCursorPos(2, contentTop + 2)
    term.setTextColor(colors.lightBlue)
    term.write("ID: " .. os.getComputerID() .. " | " .. (state.updateStatus or "Not checked"))

    addButton(w - 20, 2, " Scan ", function() state.forceUpdate = true end)
    addButton(w - 12, 2, " Update ", function()
      if not state.restartForUpdate then
        state.updateStatus = "Checking GitHub..."
        draw()
        checkForUpdate(true)
        os.queueEvent("gravesight_redraw")
      end
    end, state.updateAvailable and theme().warning or theme().panel)

    term.setCursorPos(2, contentTop + 4)
    term.setTextColor(theme().text)
    term.write("Players nearby:")
    local row = contentTop + 5
    local any = false
    for name, since in pairs(state.present) do
      if row <= contentBottom then
        term.setCursorPos(4, row)
        term.setBackgroundColor(theme().background)
        term.setTextColor(theme().text)
        term.write(name .. " (since " .. since .. ")" .. (isWhitelisted(name) and " [WHITELISTED]" or ""))
        row = row + 1
        any = true
      end
    end
    if not any then
      term.setCursorPos(4, row)
      term.setTextColor(theme().panel)
      term.write("(none)")
    end

  elseif state.activeTab == "log" then
    term.setBackgroundColor(theme().background)
    term.setTextColor(theme().text)
    local visibleRows = contentBottom - contentTop + 1
    local totalLines = #state.log
    local startIdx = math.max(1, totalLines - visibleRows + 1 - state.scrollOffset)
    local endIdx = math.min(totalLines, startIdx + visibleRows - 1)
    local row = contentTop
    for i = startIdx, endIdx do
      term.setBackgroundColor(theme().background)
      term.setTextColor(theme().text)
      term.setCursorPos(2, row)
      local line = state.log[i]
      if #line > w - 2 then line = line:sub(1, w - 2) end
      term.write(line)
      row = row + 1
    end

    addButton(w - 12, 2, " Up ", function()
      state.scrollOffset = math.min(state.scrollOffset + visibleRows, math.max(0, totalLines - visibleRows))
    end)
    addButton(w - 6, 2, " Down ", function()
      state.scrollOffset = math.max(state.scrollOffset - visibleRows, 0)
    end)

  elseif state.activeTab == "settings" then
    term.setBackgroundColor(theme().background)
    term.setTextColor(theme().text)

    -- Network Name Settings
    term.setCursorPos(2, contentTop)
    setAccent()
    term.write("NET NAME: ")
    setMuted()
    term.write(setup.stationName:sub(1, 12) .. " ")
    addButton(23, contentTop, " RENAME ", function()
      term.setCursorPos(2, contentBottom)
      term.clearLine()
      term.setTextColor(theme().accent)
      term.write("New Name: ")
      term.setTextColor(theme().text)
      local newName = read()
      if newName and newName ~= "" then
        setup.stationName = newName
        saveSettings()
        state.settingsMessage = "Renamed to " .. newName
      else
        state.settingsMessage = "Cancelled"
      end
    end)

    -- Theme Selector Buttons Restored
    term.setCursorPos(34, contentTop)
    setAccent()
    term.write("THEME:")
    addButton(41, contentTop, " S ", function() setTheme("Sculk") end, UI_THEME == "Sculk" and theme().accent or theme().panel)
    addButton(45, contentTop, " D ", function() setTheme("Deep") end, UI_THEME == "Deep" and theme().accent or theme().panel)
    addButton(49, contentTop, " A ", function() setTheme("Ancient") end, UI_THEME == "Ancient" and theme().accent or theme().panel)
    addButton(53, contentTop, " W ", function() setTheme("Warden") end, UI_THEME == "Warden" and theme().accent or theme().panel)

    -- Owner Settings
    term.setCursorPos(2, contentTop + 2)
    setAccent()
    term.write("OWNER: ")
    setMuted()
    term.write(setup.owner .. " ")
    addButton(18, contentTop + 2, " CHANGE ", function() changeOwnerProtected() end)

    -- Radii Controls
    term.setCursorPos(2, contentTop + 4)
    term.setTextColor(theme().text)
    term.write("Player Radius: " .. string.format("%-3d", RADIUS))
    addButton(21, contentTop + 4, " - ", function() RADIUS = math.max(4, RADIUS - 2); saveSettings() end)
    addButton(25, contentTop + 4, " + ", function() RADIUS = math.min(128, RADIUS + 2); saveSettings() end)

    term.setCursorPos(30, contentTop + 4)
    term.write("Geo Radius: " .. string.format("%-2d", SCAN_RADIUS))
    addButton(44, contentTop + 4, " - ", function() SCAN_RADIUS = math.max(MIN_SCAN_RADIUS, SCAN_RADIUS - 1); saveSettings() end)
    addButton(48, contentTop + 4, " + ", function() SCAN_RADIUS = math.min(32, SCAN_RADIUS + 1); saveSettings() end)

    -- Whitelist Management
    term.setCursorPos(2, contentTop + 6)
    setAccent()
    term.write("WHITELIST: ")
    addButton(14, contentTop + 6, " + ADD ", function()
      term.setCursorPos(23, contentTop + 6)
      term.setTextColor(theme().accent)
      term.write("Type Name: ")
      term.setTextColor(theme().text)
      local name = read()
      if name and name ~= "" then
        addToWhitelist(name)
        state.settingsMessage = "Added " .. name
      else
        state.settingsMessage = "Cancelled"
      end
    end)

    if state.settingsMessage ~= "" then
      term.setCursorPos(2, contentBottom)
      term.setTextColor(colors.lightBlue)
      term.write(state.settingsMessage:sub(1, math.max(1, w - 2)))
    end
  end

  clearLine(h - 1, theme().panel)
  term.setCursorPos(2, h - 1)
  term.setTextColor(theme().text)
  term.write(string.rep("-", w - 2))
  clearLine(h)

  addButton(2, h, " Exit to Shell ", function()
    term.setBackgroundColor(theme().background)
    term.clear()
    term.setCursorPos(2, 4)
    term.setTextColor(theme().accent)
    term.write("ADMIN AUTHENTICATION REQUIRED")
    term.setCursorPos(2, 6)
    term.setTextColor(theme().text)
    term.write("Password > ")
    local input = read("*")

    if passwordCorrect(input) then
      state.running = false
    else
      term.setCursorPos(2, 8)
      term.setTextColor(theme().danger)
      term.write("ACCESS DENIED - RATE LIMITED")
      sleep(math.min(8, math.pow(2, failedAttempts)))
    end
  end, colors.red, colors.white)
end

local function uiLoop()
  draw()
  while state.running do
    local event, a, b, c = os.pullEventRaw()
    if event == "mouse_click" then
      local x, y = b, c
      for _, btn in ipairs(buttons) do
        if y == btn.y and x >= btn.x1 and x <= btn.x2 then
          btn.action()
        end
      end
      if state.running then draw() end
    elseif event == "mouse_scroll" then
      local dir = a
      if state.activeTab == "log" then
        local visibleRows = (h - 2) - 4 + 1
        local totalLines = #state.log
        local maxScroll = math.max(0, totalLines - visibleRows)
        if dir < 0 then
          state.scrollOffset = math.min(state.scrollOffset + 3, maxScroll)
        elseif dir > 0 then
          state.scrollOffset = math.max(state.scrollOffset - 3, 0)
        end
        draw()
      end
    elseif event == "gravesight_redraw" then
      if state.running then draw() end
    elseif event == "terminate" then
      addLog("SECURITY WARNING: Manual termination attempt blocked.")
    end
  end
end

-- Version checker stubs
checkForUpdate = function() end

setThemeColors()

os.pullEvent = os.pullEventRaw
pcall(function() parallel.waitForAny(backgroundLoop, uiLoop) end)

term.setBackgroundColor(colors.black)
term.setTextColor(colors.white)
term.clear()
term.setCursorPos(1, 1)
print("GRAVESIGHT stopped.")
