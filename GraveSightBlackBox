-- ============================================================
-- DIYU'S GRAVESIGHT // OFFSITE BLACK BOX RECORDER
-- ============================================================
-- A standalone background logging station that catches all Rednet
-- broadcasts from your GraveSight base and writes them to a secure file.
-- ============================================================

local REDNET_CHANNEL = 999
local LOG_FILE = "secure_blackbox.log"

-- Disable Ctrl+T termination for physical security
os.pullEvent = os.pullEventRaw

-- Ensure Modem is active
local modem = peripheral.find("modem")
if not modem then
  term.setBackgroundColor(colors.black)
  term.setTextColor(colors.red)
  term.clear()
  print("CRITICAL: Wireless/Ender Modem required for Black Box log receiver!")
  return
end

for _, name in ipairs(peripheral.getNames()) do
  if peripheral.getType(name) == "modem" then rednet.open(name) end
end

term.setBackgroundColor(colors.black)
term.setTextColor(colors.green)
term.clear()
term.setCursorPos(1, 1)
print("========================================")
print("      GRAVESIGHT // BLACK BOX RECORDER  ")
print("========================================")
print(" Listening on Rednet channel " .. REDNET_CHANNEL .. "...")
print(" Secure logs writing to: " .. LOG_FILE)
print("========================================")

-- Background Recording Loop
while true do
  local senderID, payload, protocol = rednet.receive(REDNET_CHANNEL)
  
  if tonumber(protocol) == REDNET_CHANNEL and type(payload) == "table" and payload.system == "GraveSight" then
    local timeStr = payload.timestamp or os.date("%Y-%m-%d %H:%M:%S")
    local station = payload.stationName or ("Station #" .. senderID)
    local msg = payload.message or "Unknown event"
    
    local entry = string.format("[%s] (%s) %s", timeStr, station, msg)
    
    -- Print live to black box terminal
    print(entry)
    
    -- Save securely to file
    local f = fs.open(LOG_FILE, "a")
    if f then
      f.writeLine(entry)
      f.close()
    end
  end
end
