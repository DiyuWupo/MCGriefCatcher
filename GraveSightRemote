-- ============================================================
-- DIYU'S GRAVESIGHT // POCKET REMOTE (FLUX NETWORK DISCOVERY)
-- ============================================================
local REDNET_CHANNEL = 999
local LOG_FILE = "pocket_alerts.log"
local running = true

-- Disable raw Ctrl+T interruption for immersion
os.pullEvent = os.pullEventRaw

-- Robust Modem Verification & Opening
local modem = peripheral.find("modem")
if not modem then
  term.setBackgroundColor(colors.black)
  term.setTextColor(colors.red)
  term.clear()
  term.setCursorPos(1, 1)
  print("CRITICAL ERROR: Wireless/Ender Modem required!")
  while true do os.pullEvent("modem") end
end

for _, name in ipairs(peripheral.getNames()) do
  if peripheral.getType(name) == "modem" then
    rednet.open(name)
  end
end

local w, h = term.getSize()

-- ============================================================
-- NETWORK DISCOVERY (FLUX-STYLE SCANNING)
-- ============================================================
local function discoverNetworks()
  term.setBackgroundColor(colors.black)
  term.clear()
  term.setCursorPos(2, 2)
  term.setTextColor(colors.cyan)
  print("SCANNING FOR GRAVESIGHT GRIDS...")
  term.setCursorPos(2, 4)
  term.setTextColor(colors.gray)
  print("Broadcasting on channel " .. REDNET_CHANNEL .. "...")

  pcall(function()
    rednet.broadcast({ system = "GraveSightQuery", command = "discover" }, REDNET_CHANNEL)
  end)

  local stations = {}
  local timer = os.startTimer(1.5)

  while true do
    local event, p1, p2, p3 = os.pullEventRaw()
    if event == "rednet_message" then
      local senderID, payload, protocol = p1, p2, p3
      if tonumber(protocol) == REDNET_CHANNEL and type(payload) == "table" and payload.system == "GraveSightAnnounce" then
        local exists = false
        for _, s in ipairs(stations) do
          if s.id == payload.computerID then exists = true end
        end
        if not exists then
          table.insert(stations, {
            id = payload.computerID,
            name = payload.stationName or ("Station #" .. payload.computerID),
            owner = payload.owner
          })
        end
      end
    elseif event == "timer" and p1 == timer then
      break
    end
  end

  return stations
end

local selectedStation = nil

while not selectedStation do
  local found = discoverNetworks()
  
  if #found == 0 then
    term.setBackgroundColor(colors.black)
    term.clear()
    term.setCursorPos(2, 2)
    term.setTextColor(colors.red)
    print("NO GRAVESIGHT GRIDS FOUND.")
    term.setCursorPos(2, 4)
    term.setTextColor(colors.white)
    print("Ensure base computer is online")
    print("and has an Ender Modem attached.")
    term.setCursorPos(2, h)
    term.setTextColor(colors.yellow)
    print("Press ANY KEY to rescan...")
    os.pullEventRaw("key")
  elseif #found == 1 then
    selectedStation = found[1]
  else
    term.setBackgroundColor(colors.black)
    term.clear()
    term.setCursorPos(2, 2)
    term.setTextColor(colors.cyan)
    print("SELECT GRAVESIGHT NETWORK:")
    
    for i, st in ipairs(found) do
      term.setCursorPos(2, 4 + i)
      term.setTextColor(colors.white)
      print(i .. ". " .. st.name .. " (ID: " .. st.id .. ")")
    end
    
    term.setCursorPos(2, h)
    term.setTextColor(colors.yellow)
    print("Type number to connect > ")
    local input = read()
    local idx = tonumber(input)
    if idx and found[idx] then
      selectedStation = found[idx]
    end
  end
end

local BASE_ID = selectedStation.id
local stationName = selectedStation.name
local lastTimestamp = "N/A"
local lastAlert = "Connected to " .. stationName

local function drawUI()
  term.setBackgroundColor(colors.black)
  term.clear()
  
  -- Header
  term.setCursorPos(1, 1)
  term.setBackgroundColor(colors.blue)
  term.setTextColor(colors.white)
  local title = " " .. stationName .. " "
  if #title > w then title = " REMOTE " end
  local pad = string.rep(" ", math.floor((w - #title)/2))
  term.write(pad .. title .. string.rep(" ", math.ceil((w - #title)/2)))
  
  term.setBackgroundColor(colors.black)
  term.setCursorPos(1, 2)
  term.setTextColor(colors.gray)
  term.write(string.rep("-", w))

  -- Content
  term.setCursorPos(1, 4)
  term.setTextColor(colors.cyan)
  print("TIME: " .. lastTimestamp)
  
  term.setCursorPos(1, 5)
  term.setTextColor(colors.yellow)
  print("STATUS:")
  
  term.setCursorPos(1, 6)
  term.setTextColor(colors.white)
  print(lastAlert)

  -- Footer (Touch Buttons)
  term.setCursorPos(1, h - 1)
  term.setTextColor(colors.gray)
  term.write(string.rep("-", w))
  
  -- EXIT button
  term.setCursorPos(1, h)
  term.setBackgroundColor(colors.red)
  term.setTextColor(colors.white)
  print(" EXIT ")
  
  -- SCAN button
  term.setCursorPos(10, h)
  term.setBackgroundColor(colors.orange)
  term.setTextColor(colors.white)
  print(" SCAN ")
end

drawUI()

while running do
  local event, p1, p2, p3 = os.pullEventRaw()
  
  if event == "rednet_message" then
    local senderID, payload, protocol = p1, p2, p3
    
    if (tonumber(protocol) == REDNET_CHANNEL) and type(payload) == "table" and payload.system == "GraveSight" then
      lastTimestamp = payload.timestamp or os.date("%H:%M:%S")
      lastAlert = payload.message or "Unknown alert"
      
      local f = fs.open(LOG_FILE, "a")
      if f then
        f.writeLine("[" .. lastTimestamp .. "] " .. lastAlert)
        f.close()
      end
      
      drawUI()
    end
    
  elseif event == "mouse_click" then
    local button, x, y = p1, p2, p3
    
    if y == h then
      -- EXIT button check (Columns 1 to 6)
      if x >= 1 and x <= 6 then
        running = false
        
      -- SCAN button check (Columns 10 to 16)
      elseif x >= 10 and x <= 16 then
        pcall(function()
          rednet.send(BASE_ID, {system = "GraveSightCmd", command = "scan"}, REDNET_CHANNEL)
        end)
        
        lastTimestamp = os.date("%H:%M:%S")
        lastAlert = "Scan requested from " .. stationName
        drawUI()
      end
    end
  end
end

-- Clean Exit Restoration
term.setBackgroundColor(colors.black)
term.setTextColor(colors.white)
term.clear()
term.setCursorPos(1, 1)
print("Pocket remote disconnected safely.")
