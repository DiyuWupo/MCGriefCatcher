local function findPeripheral(possibleNames)
  for _, name in ipairs(peripheral.getNames()) do
    local ptype = peripheral.getType(name)

    for _, candidate in ipairs(possibleNames) do
      if ptype == candidate then
        return peripheral.wrap(name)
      end
    end
  end

  return nil
end


local playerDet = findPeripheral({
  "playerDetector",
  "player_detector"
})

local envDet = findPeripheral({
  "environmentDetector",
  "environment_detector"
})

local geoScanner = findPeripheral({
  "geoScanner",
  "geo_scanner"
})

local chatBox = findPeripheral({
  "chatBox",
  "chat_box"
})


